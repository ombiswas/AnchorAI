# ==============================================================================
# AnchorAI Server Environment Variables
# ==============================================================================

# Server Network Configuration
PORT=5000
NODE_ENV=development

# ------------------------------------------------------------------------------
# Frontend Client Origin (CORS Whitelist)
# ------------------------------------------------------------------------------
# REQUIRED IN PRODUCTION: Exact origin of the frontend web application without trailing slash.
# Examples:
#   - Development: http://localhost:5173
#   - Production:  https://anchor-ai.vercel.app
# WARNING: Omitting or misconfiguring CLIENT_URL will silently block all cross-origin requests.
CLIENT_URL=http://localhost:5173

# ------------------------------------------------------------------------------
# Database Configuration
# ------------------------------------------------------------------------------
# REQUIRED: MongoDB Atlas connection string or local MongoDB instance URI.
# The server will fail fast and crash on startup if MONGODB_URI is not set.
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/anchor_ai?retryWrites=true&w=majority

# ------------------------------------------------------------------------------
# Authentication & Security
# ------------------------------------------------------------------------------
# REQUIRED: Cryptographically secure secret string used for signing and verifying JWT tokens.
# The server will fail fast and crash on startup if JWT_SECRET is not set (no fallback string).
# Generate via: openssl rand -hex 64
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d

# ------------------------------------------------------------------------------
# Cloud Storage (Cloudinary - Optional in Dev, Recommended in Prod)
# ------------------------------------------------------------------------------
# If unconfigured in local development, uploaded files fall back to local disk storage in /uploads.
# For production deployments (e.g. Render, Railway, AWS), configure Cloudinary to persist files:
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ------------------------------------------------------------------------------
# LLM Provider Configuration (OpenAI vs. Groq)
# ------------------------------------------------------------------------------
# AnchorAI supports two high-speed inference backends:
#
# OPTION A: OpenAI (Default)
#   Set: LLM_PROVIDER=openai
#   Required: OPENAI_API_KEY (Server fails fast if missing when LLM_PROVIDER=openai)
#   Models: gpt-4o-mini (chat/quiz/primer), text-embedding-3-small (embeddings)
#
# OPTION B: Groq
#   Set: LLM_PROVIDER=groq
#   Required: GROQ_API_KEY (Server fails fast if missing when LLM_PROVIDER=groq)
#   Models: GROQ_MODEL (defaults to llama-3.3-70b-versatile or openai/gpt-oss-120b)
#   Note: OpenAI API key is still used for text-embedding-3-small vectors if available,
#         or fallback local vector embeddings.
#
LLM_PROVIDER=openai
OPENAI_API_KEY=your_openai_api_key_here
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile


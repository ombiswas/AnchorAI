# Server Environment Variables
PORT=5000
NODE_ENV=development
# REQUIRED IN PRODUCTION: URL of the frontend client application (e.g. https://your-client-domain.com).
# WARNING: Omitting or misconfiguring CLIENT_URL will silently block all production CORS requests.
CLIENT_URL=http://localhost:5173

# Database (MongoDB Atlas / Local)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/anchor_ai?retryWrites=true&w=majority

# Authentication
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d

# Storage (Cloudinary)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# AI Providers
LLM_PROVIDER=openai
OPENAI_API_KEY=your_openai_api_key_here
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b
